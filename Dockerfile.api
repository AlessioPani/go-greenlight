FROM golang:1.25-alpine AS build

WORKDIR /src

COPY go.mod go.sum ./
COPY vendor/ ./vendor/
COPY cmd/ ./cmd/
COPY internal/ ./internal/

RUN CGO_ENABLED=0 go build -mod=vendor -trimpath -ldflags="-s -w" -o /out/greenlight ./cmd/api

FROM alpine:3.22

RUN apk add --no-cache ca-certificates
COPY --from=build /out/greenlight /usr/local/bin/greenlight

EXPOSE 4000
ENTRYPOINT ["/usr/local/bin/greenlight"]
